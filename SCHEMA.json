{
  "schema_version": "1.3",
  "atlas_id": "discuss-skill-memory",
  "title": "Discuss skill process memory",
  "description": "Subject Atlas for the discuss skill. Autogenesis-authored content is scoped under autogenesis/.",
  "structure": {
    "free_layout": true,
    "staging_dir": "staging",
    "require_index_in_folders": true,
    "reserved_names": ["index.md", "log.md", "staging", "autogenesis"],
    "recommended_folders": ["autogenesis", "templates", "staging", "thesis", "residuals", "founding", "kva-tighten"]
  },
  "autogenesis_space": {
    "description": "Everything Autogenesis creates lives under this prefix.",
    "root": "autogenesis",
    "plans_dir": "autogenesis/plans",
    "plan_path_convention": "autogenesis/plans/<work_id>.md",
    "experiences_dir": "autogenesis/experiences",
    "decisions_dir": "autogenesis/decisions",
    "work_dir": "autogenesis/work"
  },
  "kva": {
    "field": "kva",
    "values": ["forming", "alive", "deprecated", "superseded", "terminated"],
    "required_on_types": ["protostar"],
    "recommended_on_types": ["experience", "decision", "document", "work"],
    "legacy_values_forbidden_after_migrate": ["expand", "keep", "terminate", "done", "active"]
  },
  "kva_role": {
    "values": ["exit-reason"],
    "when": "document that is the target of kva_deprecate|kva_supersede|kva_terminate"
  },
  "relation_kinds_added": ["kva_deprecate", "kva_supersede", "kva_terminate", "confirms", "refutes", "expands", "restates", "indexes", "defers", "absorbs", "feeds"],
  "compile": {
    "hard_fail": true,
    "allow_inline_ignores": true,
    "min_body_chars": 40,
    "core_checks": [
      "okf_compliance",
      "frontmatter",
      "internal_links",
      "not_just_links",
      "schema_present",
      "no_answerable_in_staging",
      "index_md_present"
    ],
    "simplicity_budget": {
      "max_required_frontmatter_keys_per_type": 8,
      "max_required_sections_per_type": 6
    }
  },
  "templates": {
    "directory": "templates/",
    "by_type": {
      "experience": {
        "file": "templates/experience.md",
        "frontmatter": {
          "required": ["type", "title", "created", "work_id"],
          "recommended": ["description", "tags", "status", "kva"]
        },
        "sections": {
          "required": ["Context", "What happened", "Outcome"],
          "recommended": ["Related", "Follow-ups"]
        }
      },
      "decision": {
        "file": "templates/decision.md",
        "frontmatter": {
          "required": ["type", "title", "created"],
          "recommended": ["status", "work_id", "kva"]
        },
        "sections": {
          "required": ["Decision", "Rationale"],
          "recommended": ["Alternatives considered", "Consequences"]
        }
      },
      "work": {
        "file": "templates/work.md",
        "frontmatter": {
          "required": ["type", "title", "created", "work_id"],
          "recommended": ["status", "description", "kva"]
        },
        "sections": {
          "required": ["Scope", "Status", "Outcomes"],
          "recommended": ["Related"]
        }
      },
      "plan": {
        "file": "templates/plan.md",
        "frontmatter": {
          "required": ["type", "title", "created", "work_id"],
          "recommended": ["status", "change_class", "description", "subject"]
        },
        "sections": {
          "required": ["Intent + scope", "Genesis Artifacts", "Acceptance"],
          "recommended": ["Pins", "Non-goals", "Residual risks", "Stop for approval"]
        }
      },
      "protostar": {
        "file": "templates/protostar.md",
        "frontmatter": {
          "required": ["type", "title", "created", "kva", "status"],
          "recommended": ["reality", "growth", "star_kind", "description"]
        },
        "sections": {
          "required": ["Growth path", "Open question"],
          "recommended": ["Origin"]
        }
      },
      "document": {
        "file": "templates/document.md",
        "frontmatter": {
          "required": ["type", "title", "created"],
          "recommended": ["status", "kva", "kva_role", "description"]
        },
        "sections": {
          "required": ["Context"],
          "recommended": ["Decision", "Related"]
        }
      }
    }
  },
  "query": { "search_engine": "grep" },
  "types": {
    "recommended": ["experience", "decision", "work", "plan", "document", "protostar"]
  }
}
